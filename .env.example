# Development: omit DATABASE_URL to start local embedded PostgreSQL.
# Production: an external persistent PostgreSQL is required.
# DATABASE_URL=postgres://user:password@host:5432/orbit?sslmode=require
PORT=2567
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-game.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=replace-with-a-long-random-secret
MAX_ACTIVE_ROOMS=3
# Test-only integration suite, disabled in production. Creates isolated test guests/rooms.
# ORBIT_QA=1
