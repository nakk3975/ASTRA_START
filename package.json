{
  "name": "scrap-to-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --import tsx apps/server/src/main.ts",
    "review:assets": "vite --config apps/web/vite.config.ts --open /asset-review",
    "start": "node --import tsx apps/server/src/main.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:local": "node --import tsx scripts/local-db.ts",
    "verify:design": "cd design && python3 verify_design.py",
    "test:full": "node --import tsx tests/full-run.ts",
    "format": "prettier --write apps packages scripts tests",
    "check": "npm run verify:design && npm test && npm run build",
    "test:shutdown": "node --import tsx tests/shutdown-probe.ts",
    "test:commit-recovery": "node --import tsx scripts/qa-commit-recovery.ts",
    "build:review": "tsc --noEmit && vite build --mode review --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.48",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "express": "5.1.0",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.183.1",
    "embedded-postgres": "18.6.0-beta.19",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
